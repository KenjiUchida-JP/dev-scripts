# ==================================================
# Common .gitignore (IDE, OS, Environment)
# ==================================================

# --------------------------------------------------
# Environment Variables / Secrets
# --------------------------------------------------
.env
.env.local
.env.*.local
.env.prod
.env.dev
.env.test
*.pem
*.key

# --------------------------------------------------
# IDE / Editor
# Shared settings (.vscode/settings.json, .claude/settings.json) are
# intentionally NOT ignored — only personal/local overrides are.
# --------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.claude/settings.local.json
.cursor/
*.swp
*.swo
*~

# --------------------------------------------------
# OS Generated
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --------------------------------------------------
# Logs
# --------------------------------------------------
*.log
logs/
